# =============================================================================
# Local Compose configuration template.
#
# Copy to `.env` and edit ONLY if you need to change a default:
#
#     cp .env.example .env
#
# `.env` is gitignored (see .gitignore: `.env`, `.env.*`, `!.env.example`), so
# real values never reach the repository.
#
# IMPORTANT: this file is OPTIONAL. Every key below has a working default baked
# into compose.yaml, so `docker compose up --build` works with no `.env` at all.
# It exists so the host-port choices and the model name are visible and
# adjustable without editing the Compose file.
#
# This file must NEVER contain a real credential. The validated workflow uses
# local Ollama, which requires no API key.
# =============================================================================

# -----------------------------------------------------------------------------
# Host port mapping
#
# The container-to-container ports are fixed by the service contract and are
# NOT configurable: api listens on 3000, ai-engine listens on 8000, and the
# backend dials http://ai-engine:8000 by service name.
#
# Only the HOST side of the mapping is adjustable, to avoid colliding with a
# development process already bound to 3000 or 8000.
# -----------------------------------------------------------------------------

# Host port for the NestJS backend. Default 3002.
# Set to 3000 to claim the conventional port (requires 3000 to be free).
API_HOST_PORT=3002

# Host port for the AI Engine. Default 8002.
# Set to 8000 to claim the conventional port (requires 8000 to be free).
AI_ENGINE_HOST_PORT=8002

# -----------------------------------------------------------------------------
# Model and timeouts
# -----------------------------------------------------------------------------

# Ollama model tag. llama3 is the model verified end-to-end.
# The model must already be pulled on the host: `ollama list`
AI_ENGINE_MODEL=llama3

# Seconds the AI Engine waits for Ollama before returning 504 PROVIDER_TIMEOUT.
# Keep in mind that llama3 on CPU-only hardware takes tens of seconds per
# analysis (~34s measured).
AI_ENGINE_REQUEST_TIMEOUT=60

# Milliseconds the NestJS backend waits for one AI Engine call. Must exceed
# real inference time. An AI Engine 504 and a local abort both surface to
# callers as 504 Gateway Timeout, so crossing this bound is consistent.
AI_ENGINE_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Credentials
#
# Intentionally empty and intentionally omitted.
#
# The validated workflow is PROVIDER=ollama, which needs no API key. Do not set
# PROVIDER_API_KEY here for Ollama -- the AI Engine ignores it, and a key in
# this file would be committed if .gitignore were ever bypassed.
#
# PROVIDER_API_KEY is required only for a cloud provider (openai / anthropic).
# If one is ever used, inject it from your shell or a secret manager instead of
# writing it into a file.
# -----------------------------------------------------------------------------

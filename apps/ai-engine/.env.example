# AI Engine environment variables — REFERENCE TEMPLATE ONLY
#
# The application does NOT read this file, and it does NOT read a .env file.
# python-dotenv is not a dependency and app/config.py uses os.getenv() only,
# so a .env file placed next to the application is ignored.
#
# Use this file as the list of supported variables and their default values.
# Supply the values to the process through the shell, the service manager, or
# the container runtime (see README.md -> "Provider configuration").
#
# Never commit real credentials.

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Logging ────────────────────────────────────────────────────────────────
# Threshold for this service's own log records (DEBUG/INFO/WARNING/ERROR).
# Consumed by app/observability.py.  An unrecognised value falls back to INFO
# rather than failing startup.  Does not affect the web server's own loggers.
LOG_LEVEL=INFO

# ── Provider selection ──────────────────────────────────────────────────────
# Supported values: ollama
PROVIDER=ollama

# ── Model ──────────────────────────────────────────────────────────────────
# Model name forwarded to the provider (e.g. llama3, codellama, mistral)
MODEL=llama3

# ── Provider base URL (self-hosted providers) ───────────────────────────────
PROVIDER_BASE_URL=http://localhost:11434

# ── Request timeout ─────────────────────────────────────────────────────────
# Seconds to wait for a provider response before raising a 504 error.
REQUEST_TIMEOUT=60

# ── API key (cloud providers only) ─────────────────────────────────────────
# Required when PROVIDER=openai or PROVIDER=anthropic.
# Do NOT set this for Ollama.
# PROVIDER_API_KEY=your-provider-api-key-here
